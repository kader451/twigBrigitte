{% extends 'base.html.twig' %}

{% block title %}Animals index{% endblock %}

{% block body %}

    <h1>Nos animaux</h1>
<div class ="containerAnimal">
    {% for animal in animals %}
        <div class="cardAnimal">

        <h2>{{ animal.nom }}</h2>
        <p> Adoptable : {{ animal.adoptable ? 'Yes' : 'No' }}</p>
        <p>Sexe : {{ animal.sexe }}</p>
        <p>Id : {{ animal.id }}</p>

       <div class="btnShowEdit">
            <a href="{{ path('app_animals_show', {'id': animal.id}) }}">show</a>
            <a href="{{ path('app_animals_edit', {'id': animal.id}) }}">edit</a>
</div>

</div>

{% endfor %}
</div>
 <a href="{{ path('app_animals_new') }}">Create new</a>
{% endblock %}   
