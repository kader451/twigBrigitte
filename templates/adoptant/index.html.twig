{% extends 'base.html.twig' %}

{% block title %}Adoptant index{% endblock %}

{% block body %}  

    <h1>Adoptant index</h1>

  <table class="cardAnimal">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for adoptant in adoptants %}
            <tr>
                <td>{{ adoptant.id }}</td>
                <td>{{ adoptant.nom }}</td>
                <td >
                    <a href="{{ path('app_adoptant_show', {'id': adoptant.id}) }}" class="btnShowEdit">show</a>
                    <a href="{{ path('app_adoptant_edit', {'id': adoptant.id}) }}" >edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_adoptant_new') }}">Create new</a>
{% endblock %}
