{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon site{% endblock %}</title>


    {% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('app.css') }}">
    {% endblock %}
</head>

<body>
    <header>
        <nav aria-label="Navigation principale">
            <ul class="structureNavBarre">
                <li><a href="{{ path('app_animals_index') }}" class="buttonNav">List of animals</a></li>
                <li><a href="{{ path('app_adoptant_index') }}" class="buttonNav">List of adoptants</a></li>

            </ul>

        </nav>
    </header>

    <main class='main'>
        {% block body %}{% endblock %}
    </main>
    <footer>
        <p>&copy; 2025 MonSite MVC — Tous droits réservés.</p>
    </footer>
</body>

</html>